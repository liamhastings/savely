# One .env at the repo root is shared by the server and the web app.
# Only keys starting with VITE_ are ever sent to the browser.

# --- Server ---
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/savely

# Plaid (Sandbox first; switch PLAID_ENV to production for Production Trial)
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# 32-byte hex key for AES-256-GCM encryption of Plaid access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Supabase (users sign in through Supabase Auth) ---
# Project URL: Supabase dashboard → Project Settings → API. The server uses it to
# verify sign-in tokens against the project's public signing keys.
SUPABASE_URL=https://your-project.supabase.co
# Only for older projects that still sign tokens with the legacy shared JWT secret:
# SUPABASE_JWT_SECRET=

# Optional: comma-separated list of sites allowed to call the API (set when hosting).
# WEB_ORIGIN=https://savely.example.com

# --- Web app (browser-visible) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (called the "anon" key on older projects). NOT the secret/service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where the browser reaches the API server.
VITE_API_URL=http://localhost:4000
